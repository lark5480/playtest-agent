{
  "name": "playtest-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AI 游戏自动测试 Agent —— 自主开局、按策略游玩、为每步产出治理证据、产出可复现缺陷报告",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:contract": "node --import tsx --test tests/contract/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx --test tests/integration/*.test.ts",
    "test:integration:games": "node --env-file-if-exists=.env --import tsx --test tests/integration/chess-arena.test.ts tests/integration/concurrency.test.ts tests/integration/crash-resume.test.ts",
    "test:integration:aiwarden": "node --env-file-if-exists=.env --import tsx --test tests/integration/aiwarden-governance.test.ts tests/integration/aiwarden-usage.test.ts",
    "test:integration:resume": "node --env-file-if-exists=.env --import tsx --test tests/integration/crash-resume-process.test.ts",
    "test:integration:llm": "node --env-file-if-exists=.env --import tsx --test tests/integration/llm-real.test.ts",
    "test:integration:tongshi": "node --env-file-if-exists=.env --import tsx --test tests/integration/tongshi-duel.test.ts",
    "test:all": "npm run test && npm run test:contract && npm run test:integration",
    "playtest": "node --env-file-if-exists=.env --import tsx src/cli.ts playtest",
    "scan": "node --env-file-if-exists=.env --import tsx src/cli.ts scan",
    "report:html": "node --env-file-if-exists=.env --import tsx src/cli.ts report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1"
  }
}
