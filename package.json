{
  "name": "playtest-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI 游戏自动测试 Agent —— 自主开局、按策略游玩、为每步产出治理证据、产出可复现缺陷报告",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:contract": "node --import tsx --test tests/contract/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:all": "npm run test && npm run test:contract && npm run test:integration",
    "playtest": "node --import tsx src/cli.ts playtest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1"
  }
}
