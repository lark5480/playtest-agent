# 复制为 .env 并按需填写；不要把真实密钥提交到仓库。
# playtest / scan / report:html 与多数 test:integration:* 脚本通过 --env-file-if-exists=.env
# 自动加载（以 package.json 为准）；demo / replay / report:diff 等零密钥命令不加载。
# shell / CI 显式注入的变量优先于 .env。

# 被测游戏
GAME_BASE_URL=http://localhost:5173
CHESS_ARENA_BASE_URL=http://localhost:3000
TONGSHI_JU_BASE_URL=http://localhost:3100

# 真实模型（OpenAI 兼容）
AI_API_BASE=
AI_API_KEY=
AI_MODEL=
# reasoning 模型需要更大的 token 预算与超时
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=60000

# aiwarden 治理面
AIWARDEN_BASE_URL=http://localhost:8080
AIWARDEN_TENANT_ID=1
AIWARDEN_USER_ID=playtest-agent
# /api/v1/admin/usage 要求数值主体，不能用 playtest-agent
AIWARDEN_ADMIN_USER_ID=1
AIWARDEN_TOOL=create_ticket

# 集成测试门禁：0=依赖不可达时跳过；1=强制失败
PLAYTEST_REQUIRE_INTEGRATION=0
